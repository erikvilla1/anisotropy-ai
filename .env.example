# Public API address, embedded into the website at build time. No credentials.
# Copy to .env.local for local development; restart Next.js or rebuild after changes.
NEXT_PUBLIC_ANISOTROPY_API_URL=http://127.0.0.1:8000

# Local PostgreSQL for run records (ADR-0025). Copy this file to .env and choose a password.
# Compose refuses to start the database while POSTGRES_PASSWORD is empty.
POSTGRES_PASSWORD=
# Read by the API at startup (and by `alembic upgrade head`); use the same password as above.
# The API refuses to start without it unless ANISOTROPY_RUN_RECORDS=off is set on purpose (ADR-0026).
DATABASE_URL=postgresql+psycopg://anisotropy:CHANGE-ME@127.0.0.1:5432/anisotropy
# The API tests empty this second database (created by docker/initdb on the volume's first start).
TEST_DATABASE_URL=postgresql+psycopg://anisotropy:CHANGE-ME@127.0.0.1:5432/anisotropy_test
# ANISOTROPY_RUN_RECORDS=off

# Hosted records on Neon instead (ADR-0056, ADR-0025 amendment 1): `neon deploy` or `neon env pull` writes DATABASE_URL (pooled),
# DATABASE_URL_UNPOOLED and NEON_BRANCH here from the branch named in the git-ignored .neon file. Their plain postgresql://...
# ?sslmode=require addresses are routed to psycopg by the API; migrations use the unpooled one when it is set. Leave the two
# lines out to keep the Docker server above.
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=

# The assistant (ADR-0052): off unless a provider is named. With it on, the model rephrases the template's explanation and a
# guard withholds any draft whose numbers are not the engine's. Needs the model's name and the SDK's credential.
# ANISOTROPY_ASSISTANT_PROVIDER=anthropic
# ANISOTROPY_ASSISTANT_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Cloudflare Access in front of the API (ADR-0056): with both set, every request but GET /healthz must carry the token Access adds
# (Cf-Access-Jwt-Assertion), checked against the team's published keys, and the signed-in email goes to the run records as
# user_email (ADR-0026 amendment 1). The team domain is <team>.cloudflareaccess.com; the audience tag is on the Access
# application's page under Additional settings. Leave both out locally.
# ANISOTROPY_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# ANISOTROPY_ACCESS_AUD=
# The website origins that may read the API from a browser, comma-separated; unset, the local development origins apply.
# ANISOTROPY_ALLOWED_ORIGINS=https://studio.example.com
