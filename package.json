{
  "name": "anisotropy-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "serve out -l 3000",
    "preview": "serve out -l 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "monitor:start": "tsx services/material-monitor/server.ts",
    "monitor:check": "tsx services/material-monitor/server.ts --once",
    "test:monitor": "tsx --test tests/material-monitor.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cheerio": "^1.2.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "serve": "^14.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
