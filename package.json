{
  "name": "anisotropy-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:hosted": "tsx scripts/build-hosted.ts",
    "start": "serve out -l 3000",
    "preview": "serve out -l 3001",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "wrangler types && tsc -p worker",
    "deploy": "wrangler deploy",
    "export:library": "tsx scripts/export-material-library.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:calculator": "playwright test --config playwright.calculator.config.ts",
    "monitor:start": "tsx services/material-monitor/server.ts",
    "monitor:check": "tsx services/material-monitor/server.ts --once",
    "test:monitor": "tsx --test tests/material-monitor.test.ts",
    "test:studio": "playwright test --config playwright.studio.config.ts",
    "test:studio-live": "playwright test --config playwright.studio-live.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "cheerio": "^1.2.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "serve": "^14.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.0"
  }
}
