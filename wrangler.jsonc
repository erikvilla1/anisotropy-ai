// The hosted tier on Cloudflare (ADR-0056): one Worker serves the website's static export and forwards /api/* to the solver
// container, built from the Dockerfile at this root. Deploy with `npx wrangler deploy` (Docker must be running: Wrangler builds
// and pushes the image) after `npm run build:hosted`. docs/walkthroughs/hosted-deploy.md explains.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anisotropy-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // The one address (ADR-0056 amendments 1 and 2): anisotropy.dev as a custom domain, for which Cloudflare makes the DNS record and
  // the certificate. No workers.dev address and no preview URLs, so Access guards one origin and the bucket's CORS lists one.
  "routes": [{ "pattern": "anisotropy.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The site: Next.js writes it to out/. The Worker runs first only for the API's paths; everything else is a static file,
  // /studio from studio.html with or without the slash, and a miss gets the site's 404 page.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Two containers from one image (Dockerfile: the API with CalculiX, Gmsh and Tectonic). ApiContainer is the API's own, one
  // instance: with the queue below it files coupon jobs and runs none. SolverContainer runs one coupon job each, named by the job's
  // id (ADR-0056 stage 3, amendments 3 and 4); its max_instances is the jobs that run at once (a job past it waits in the queue, and
  // a finished job's container keeps its place until it sleeps, 3 minutes later). standard-3 is the plan's starting size, to be
  // adjusted from each job's measured peak memory (jobs.peak_memory_bytes).
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 1
    },
    {
      "class_name": "SolverContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "ApiContainer" },
      { "name": "SOLVER", "class_name": "SolverContainer" }
    ]
  },
  "exports": {
    "ApiContainer": { "type": "durable-object", "storage": "sqlite" },
    "SolverContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  // The job queue: the Worker sends each filed job's id (the binding turns the API's role to `queue`, worker/routing.ts) and this
  // Worker consumes them one per invocation: it starts the job in its SolverContainer and returns within seconds, and the solver's
  // own timer watches the job (worker/solver-queue.ts, amendment 4). A job that could not start (no free solver) comes back 15 s
  // later, then up to 45 s; one whose coupon another job holds is sent again by the timer, 30 s later. A message that fails 100
  // times goes to the dead-letter queue. Wrangler creates a missing queue on deploy (docs/walkthroughs/hosted-deploy.md).
  "queues": {
    "producers": [{ "queue": "anisotropy-coupon-jobs", "binding": "JOB_QUEUE" }],
    "consumers": [
      {
        "queue": "anisotropy-coupon-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 10,
        "max_retries": 100,
        "retry_delay": 30,
        "dead_letter_queue": "anisotropy-coupon-jobs-dead"
      }
    ]
  }
  // Secrets, never here: `npx wrangler secret put <NAME>` for DATABASE_URL, the ANISOTROPY_ACCESS_*, ANISOTROPY_R2_* and
  // assistant variables; the Worker hands them to the container (worker/routing.ts names them). ANISOTROPY_GIT_COMMIT is set by
  // the deploy workflow as a variable (`--var`).
}
